# Point at Service 3 (Vulnerabilities) only — not forensic or mobile-extract.
# Site root; scanner-agent appends /api/scanner-agent/... itself.
# Local split: http://host.docker.internal:3003  (or :8082 if hitting the API)
CENTRAL_API_URL=https://122.170.114.36

# Legacy LAN discovery fallback only. Used only when CENTRAL_API_URL=AUTO.
# After the split the vuln API health role is vuln-api (port 8082 / UI 3003).
CENTRAL_API_PORT=8082

# Firm tenant slug (same as login organization / X-Tenant)
TENANT_SLUG=aetheris

# Filled automatically by Start-Laptop (kept in sync with scanner-agent/.agent-token).
AGENT_TOKEN=replace-me
# Leftover from older laptops. Start-Laptop still tries it, then promotes a match into AGENT_TOKEN.
AGENT_RECOVERY_TOKEN=

# Do not use these to skip login. Start-Laptop always asks for the emailed
# access token (same token as Forensic / Mobile extract web login).
FIRM_EMAIL=
FIRM_PASSWORD=
# Optional. Bind this laptop to a specific scanner instead of auto-picking.
# SCANNER_NAME=Laptop-MYPC
# SCANNER_ID=

# Local Greenbone admin (set on first start by Start-Laptop)
GVM_USERNAME=admin
GVM_PASSWORD=admin
GVM_SOCKET_PATH=/run/gvmd/gvmd.sock

# Agent tuning
POLL_INTERVAL_SEC=15
HEARTBEAT_INTERVAL_SEC=60
QUEUE_POLL_INTERVAL_SEC=3
STALL_PROGRESS_PCT=95
STALL_SEC=0
PORT_PROFILE=full
VERIFY_TLS=true
# 0 = wait until the central API responds (no read deadline).
CENTRAL_API_TIMEOUT_SEC=0
AGENT_VERSION=1.2.19

# persistent_edge | portable  (must match the scanner role in the central UI)
SCANNER_ROLE=portable

# Parallelism: one Scan Job in the UI; each IP is its own OpenVAS chunk.
# SCAN_IP_PARALLELISM=auto → minimum 5 one-IP workers, scaling to 10 while cool.
# Warm/hot hosts stay at the five-worker floor; critical thermal/RAM pressure pauses NEW starts.
# Existing OpenVAS tasks always finish and release their permit.
MAX_CONCURRENT_SCAN_JOBS=1
SCAN_IP_PARALLELISM=auto
SCAN_IP_MAX_PARALLELISM=10
GVM_MAX_HOSTS=10
GVM_MAX_CHECKS=12
# Thermal/load admission for new OpenVAS IP tasks. Existing tasks finish safely.
SCAN_CPU_THROTTLE_C=84
SCAN_CPU_PAUSE_C=92
# Optional when container cannot read host sensors; a host monitor can publish it.
# SCAN_HOST_TEMP_C=
# Skip hosts that fail a quick TCP reachability probe before OpenVAS starts.
SKIP_UNREACHABLE_TARGETS=true
REACHABILITY_TIMEOUT_SEC=0.5
REACHABILITY_WORKERS=10
# Durable per-IP JSONL logs are also shipped through the normal scanner log API.
IP_SCAN_LOG_DIR=/app/logs/ip
HIGH_PROGRESS_WARN_SEC=300
MAX_SCAN_RUNTIME_SEC=0

# Full VA result fidelity
GVM_REPORT_MIN_QOD=0
# Refuse scans while the Greenbone feed/config is visibly incomplete.
GVM_MIN_NVT_COUNT=10000
# Never silently create a bare task if Greenbone rejects quality preferences.
GVM_ALLOW_BARE_TASK_FALLBACK=false
GVM_OPTIMIZE_TEST=no
GVM_SAFE_CHECKS=yes
GVM_EXPAND_VHOSTS=yes
GVM_TEST_EMPTY_VHOST=yes
GVM_CHECKS_READ_TIMEOUT=10
GVM_TIMEOUT_RETRY=3
GVM_OPEN_SOCK_MAX_ATTEMPTS=5
