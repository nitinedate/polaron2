# Prefer AUTO with laptop Start-Laptop.cmd (LAN discovery). Manual override:
CENTRAL_API_URL=AUTO
# Firm tenant slug (X-Tenant), e.g. aetheris
TENANT_SLUG=aetheris
# One-time token from Vuln → Scanners → edge agent create/rotate
AGENT_TOKEN=replace-me

# Local Greenbone GMP on this laptop
GVM_SOCKET_PATH=/run/gvmd/gvmd.sock
# Or TCP: GVM_URL=tls://127.0.0.1:9390
GVM_USERNAME=admin
GVM_PASSWORD=admin

POLL_INTERVAL_SEC=15
HEARTBEAT_INTERVAL_SEC=60
STALL_PROGRESS_PCT=95
STALL_SEC=180
PLUGINS_TIMEOUT_SEC=0
SCANNER_PLUGINS_TIMEOUT_SEC=0
PORT_PROFILE=full
VERIFY_TLS=true
AGENT_VERSION=1.0.0

# Full VA result fidelity
GVM_REPORT_MIN_QOD=0
GVM_OPTIMIZE_TEST=no
GVM_SAFE_CHECKS=yes
GVM_CHECKS_READ_TIMEOUT=10
GVM_TIMEOUT_RETRY=3
GVM_OPEN_SOCK_MAX_ATTEMPTS=5
GVM_EXPAND_VHOSTS=yes
GVM_TEST_EMPTY_VHOST=yes
GVM_MIN_NVT_COUNT=10000
GVM_ALLOW_BARE_TASK_FALLBACK=false
