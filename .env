# Disk extraction (I/O-bound ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Â ÃƒÂ¢Ã¢â€šÂ¬Ã¢â€žÂ¢ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã‚Â ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬ÃƒÂ¢Ã¢â‚¬Å¾Ã‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€¦Ã‚Â¡ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Â ÃƒÂ¢Ã¢â€šÂ¬Ã¢â€žÂ¢ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€¦Ã‚Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã‚Â¦ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¡ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€¦Ã‚Â¡ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Â ÃƒÂ¢Ã¢â€šÂ¬Ã¢â€žÂ¢ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã¢â‚¬Â¦Ãƒâ€šÃ‚Â¡ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€¦Ã‚Â¡ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â GPU does not speed this stage; restart worker-disk after changes)
# Per-job shard workers; auto-halved when 2ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Â ÃƒÂ¢Ã¢â€šÂ¬Ã¢â€žÂ¢ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã‚Â ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬ÃƒÂ¢Ã¢â‚¬Å¾Ã‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€¦Ã‚Â¡ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Â ÃƒÂ¢Ã¢â€šÂ¬Ã¢â€žÂ¢ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€¦Ã‚Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã‚Â¦ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¡ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€¦Ã‚Â¡ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Â ÃƒÂ¢Ã¢â€šÂ¬Ã¢â€žÂ¢ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã¢â‚¬Â¦Ãƒâ€šÃ‚Â¡ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€šÃ‚Â¦ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã¢â‚¬Â¦ÃƒÂ¢Ã¢â€šÂ¬Ã…â€œ3 disks run together.
EXTRACT_DISK_WORKERS=8
# Mobile/UFED zip dumps: up to 2ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Â ÃƒÂ¢Ã¢â€šÂ¬Ã¢â€žÂ¢ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã‚Â ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬ÃƒÂ¢Ã¢â‚¬Å¾Ã‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€¦Ã‚Â¡ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Â ÃƒÂ¢Ã¢â€šÂ¬Ã¢â€žÂ¢ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€¦Ã‚Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã‚Â¦ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¡ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€¦Ã‚Â¡ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Â ÃƒÂ¢Ã¢â€šÂ¬Ã¢â€žÂ¢ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã¢â‚¬Â¦Ãƒâ€šÃ‚Â¡ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€šÃ‚Â¦ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã¢â‚¬Â¦ÃƒÂ¢Ã¢â€šÂ¬Ã…â€œ3 parallel ZipFile readers. Live perf plan drops to 1 when CPU hot.
EXTRACT_MOBILE_WORKERS=12
EXTRACT_SHARD_COUNT=14
EXTRACT_UPLOAD_CONCURRENCY=4
EXTRACT_ZSTD_LEVEL=1
MAX_CONCURRENT_DISK_BUILDS=4
# Fresh inode-ordered sequential shards + streamed Phase3/RAG (NVMe ~1h target)
EXTRACT_REPLAN_ON_RESUME=false
# forensic = RAG evidence set only (skips WinSxS/DLL noise). defensible = court-safe superset. full = every file.
EXTRACT_MODE=defensible
EXTRACT_UNCERTAIN_MAX_BYTES=4194304
# SHA-256 every file roughly doubles CPU work; disable for speed (re-enable if you need digests).
EXTRACT_HASH_FILES=false
EXTRACT_MAX_FILE_BYTES=100000000
EXTRACT_SKIP_SYSTEM_PATHS=false
# V45: AXIOM-aligned tree-level OS/vendor exclusion (scope-pack artifacts are never dropped)
EXTRACT_OS_VENDOR_TREES=skip
EXTRACT_OS_VENDOR_SMALL_KEEP_BYTES=0
PARSE_DRAIN_MAX_ROUNDS=40
PARSE_BATCH_LIMIT=8000
PARSE_DRAIN_BATCH_LIMIT=2500
PARSE_FILE_TIMEOUT_SEC=0
PARSE_DRAIN_FORENSIC_ONLY=true
PARSE_DRAIN_INTERLEAVE_RAG=false
PARSE_DRAIN_REQUEUE_NO_PARSER=false
# Parallel parse: 4 Celery buckets x ~3 threads (PARSE_WORKERS is the total).
PARSE_WORKERS=16
PARSE_PARALLEL_ENABLED=true
PARSE_PARALLEL_BUCKETS=4
PARSE_DB_COMMIT_BATCH=100
# Default forensic flow: finish one-time evidence extraction before registration/OCR/parse/RAG.
EXTRACT_THEN_PROCESS=true
PHASE3_STREAM_DURING_EXTRACT=false
PHASE3_STREAM_RAG_DURING_EXTRACT=false
PHASE3_STREAM_OCR_DURING_EXTRACT=false
EXTRACT_PROGRESS_STEP=2000
EXTRACT_STOP_CHECK_INTERVAL=1000
# V45 streaming shard worker
EXTRACT_READ_SEMAPHORE=8
EXTRACT_HDD_READERS=2
EXTRACT_HDD_CHUNK_BYTES=8388608
EXTRACT_READ_CHUNK_BYTES=4194304
EXTRACT_SPOOL_MAX_BYTES=33554432
EXTRACT_SCRATCH_DIR=/scratch
# Set when Docker Desktop hides the block device: hdd | ssd | nvme | auto
DISK_SOURCE_MEDIA=auto
EXTRACT_TAR_BUFSIZE=2097152
EXTRACT_PROGRESS_FLUSH_SEC=10
EXTRACT_PROGRESS_LOG_SEC=20
# GPU embeddings ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Â ÃƒÂ¢Ã¢â€šÂ¬Ã¢â€žÂ¢ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã‚Â ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬ÃƒÂ¢Ã¢â‚¬Å¾Ã‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€¦Ã‚Â¡ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Â ÃƒÂ¢Ã¢â€šÂ¬Ã¢â€žÂ¢ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€¦Ã‚Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã‚Â¦ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¡ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€¦Ã‚Â¡ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Â ÃƒÂ¢Ã¢â€šÂ¬Ã¢â€žÂ¢ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã¢â‚¬Â¦Ãƒâ€šÃ‚Â¡ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€¦Ã‚Â¡ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â laptop-safe batches + thermal pulse (cool sprint / warm rest)
RAG_EMBEDDING_DEVICE=cuda
RAG_EMBEDDING_MODEL=BAAI/bge-m3
RAG_BATCH_SIZE=24
RAG_BATCH_SIZE_CAP=24
# Exclusive RAG after OCR unload ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Â ÃƒÂ¢Ã¢â€šÂ¬Ã¢â€žÂ¢ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã‚Â ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬ÃƒÂ¢Ã¢â‚¬Å¾Ã‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€¦Ã‚Â¡ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Â ÃƒÂ¢Ã¢â€šÂ¬Ã¢â€žÂ¢ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€¦Ã‚Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã‚Â¦ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¡ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€¦Ã‚Â¡ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Â ÃƒÂ¢Ã¢â€šÂ¬Ã¢â€žÂ¢ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã¢â‚¬Â¦Ãƒâ€šÃ‚Â¡ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€¦Ã‚Â¡ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â 12GB card can hold BGE at ~55% VRAM.
RAG_CUDA_MEMORY_FRACTION=0.35
RAG_CHUNK_SIZE=2200
RAG_CHUNK_OVERLAP=200
# Keep CUDA embeddings running after the ~500-chunk Q&A baseline.
RAG_BACKGROUND_AFTER_BASELINE=true
RAG_EMBEDDING_ENABLED=false
# Independent GPU slots: OCR and background RAG may run together.
# V45.1: with embeddings ON, RAG yields to OCR by pending-count (one log line, then OCR drain
# kicks RAG when it finishes) instead of colliding on the GPU lane every 120 s.
DEFER_BACKGROUND_RAG_WHILE_OCR=true
# Balanced thermal: fast when cool, hard caps before OEM trip (~95-100C GPU / ~100C CPU).
GPU_THERMAL_ENABLED=true
GPU_THERMAL_START_MAX_C=90
GPU_THERMAL_THROTTLE_C=87
GPU_THERMAL_PAUSE_C=92
GPU_THERMAL_RESUME_C=84
GPU_THERMAL_COOL_BOOST_C=58
GPU_THERMAL_COOL_BATCH_MULTIPLIER=1.0
GPU_THERMAL_POLL_SEC=2
GPU_THERMAL_HOT_BATCH_SLEEP_SEC=4
GPU_THERMAL_EMBED_REST_SEC=0.35
GPU_THERMAL_DUTY_CYCLE_BATCHES=6
GPU_THERMAL_DUTY_CYCLE_REST_SEC=2
GPU_THERMAL_ADAPTIVE_BATCH=true
GPU_THERMAL_FALLBACK_DUTY=true
# Ignore small warm-up spikes; only react to sharp rises near throttle.
GPU_THERMAL_RISE_DELTA_C=8
GPU_THERMAL_RISE_WINDOW_SEC=10
# Cool-path ceiling; adaptive_power_limit drops to ~50W when hot
GPU_THERMAL_POWER_LIMIT_W=120
GPU_THERMAL_UNLOAD_OLLAMA_BEFORE_RAG=true
GPU_THERMAL_ABORT_C=94
# Two independent GPU slots so OCR and RAG can run at the same time.
# V45: one heavy GPU resident at a time on a 12 GB RTX 3060 (OCR -> embeddings -> LLM)
GPU_HEAVY_MAX_CONCURRENT=1
# V45.1: RAG/OCR run on dedicated solo workers; a real wait budget avoids one-shot failures
# when the other task is seconds from releasing the lane.
GPU_HEAVY_LOCK_WAIT_SEC=180
GPU_HEAVY_LOCK_TTL_SEC=600
CPU_THERMAL_THROTTLE_C=86
CPU_THERMAL_PAUSE_C=94
PIPELINE_SUPERVISOR_ENABLED=true
PIPELINE_STALE_SEC=55
PIPELINE_SUPERVISOR_INTERVAL_SEC=30
RAG_AUTO_AFTER_DISK=false
PHASE3_AUTO_AFTER_DISK=true
# 12GB VRAM only (RTX 5070 Ti laptop). No 15GB+ / 27b / 32b / 70b.
LLM_PRIMARY_MODEL=qwen2.5:14b
LLM_REVIEW_MODEL=deepseek-r1:14b
LLM_REVIEW_MODEL_LARGE=deepseek-r1:14b
LLM_FAST_MODEL=qwen3.5:9b
# App roles only: primary / review / fast-agent / gap / fallback / embed
OLLAMA_PULL_MODELS=qwen2.5:14b,qwen2.5:7b,deepseek-r1:14b,llama3.1:8b,gemma4:12b,qwen3.5:9b,nomic-embed-text
OLLAMA_KEEP_ALIVE=2m
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_NUM_PARALLEL=1
OCR_ENABLED=true
OCR_ENGINE=glm-ocr
OCR_MODEL=zai-org/GLM-OCR
OCR_DEVICE=cuda
OCR_GPU_ONLY=true
# OCR PDFs + Documents/Downloads/Desktop only. Camera rolls stay skipped.
OCR_BATCH_LIMIT=48
OCR_DRAIN_MAX_ROUNDS=60
OCR_DOCUMENTS_ONLY=true
OCR_MAX_PAGES=8
OCR_MAX_NEW_TOKENS=512
OCR_MAX_IMAGE_EDGE=1152
OCR_CPU_WORKERS=6
OCR_CUDA_MEMORY_FRACTION=0.80
# HuggingFace models used by GPU workers (huggingface_cache volume)
RAG_EMBEDDING_MODEL=BAAI/bge-m3
RAG_EMBEDDING_FALLBACK=nomic-embed-text
RAG_IMAGE_EMBED_MODEL=clip-ViT-B-32
HF_PULL_MODELS=BAAI/bge-m3,zai-org/GLM-OCR,sentence-transformers/clip-ViT-B-32,cross-encoder/ms-marco-MiniLM-L-6-v2
GAP_REPORT_LLM_ENABLED=true
GAP_REPORT_LLM_MODEL=qwen2.5:7b
# Mobile report findings in simple client language (no paths / technical jargon)
MOBILE_REPORT_LLM_ENABLED=true
MOBILE_REPORT_LLM_MODEL=qwen2.5:14b
MOBILE_REPORT_LLM_FALLBACK_MODEL=llama3.1:8b
MOBILE_REPORT_LLM_MODELS=qwen2.5:14b,gemma4:12b,qwen3.5:9b,llama3.1:8b,qwen2.5:7b

VULN_MODULE_ENABLED=true
AGENT_MODULE_ENABLED=true
AGENT_MAX_STEPS=6
AGENT_MODEL=qwen3.5:9b

NESSUS_API_TIMEOUT_SEC=0
NESSUS_VERIFY_SSL=true
NESSUS_DEFAULT_URL=
NESSUS_ACCESS_KEY=
NESSUS_SECRET_KEY=

# Multi-scanner orchestration
VULN_ORCHESTRATION_ENABLED=true
VULN_ALLOW_STUB_FINDINGS=false
GVM_HOST=gvmd
GVM_PORT=9390
GVM_URL=unix:///run/gvmd/gvmd.sock
GVM_SOCKET_PATH=/run/gvmd/gvmd.sock
GVM_USERNAME=admin
GVM_PASSWORD=admin
GVM_ADMIN_PASSWORD=admin
GVM_VERIFY_TLS=false
GVM_LIVE_ENABLED=true
GVM_SCAN_POLL_INTERVAL_SEC=5
GVM_SCAN_TIMEOUT_SEC=240
GVM_SCAN_NEAR_COMPLETE_GRACE_SEC=0
GVM_SCAN_NEAR_COMPLETE_PROGRESS_PCT=85
GVM_SCAN_STALL_PROGRESS_PCT=80
GVM_SCAN_STALL_SEC=90
GVM_SCAN_CONFIG=Full and fast
GVM_FEED_READY_TIMEOUT_SEC=0
GVM_PORT_PROFILE=full
GVM_TARGET_PORT_RANGE=
GVM_MAX_CHECKS=20
GVM_MAX_HOSTS=8
GVM_OPTIMIZE_TEST=false
GVM_THOROUGH_TESTS=false
GVM_PLUGINS_TIMEOUT_SEC=0
GVM_SCANNER_PLUGINS_TIMEOUT_SEC=0
VULN_ORCH_OVERLAP_ENABLED=true
ZAP_API_URL=http://zap:8080
ZAP_API_KEY=changeme
ZAP_SCAN_TIMEOUT_SEC=180
VULN_TARGET_WORKERS=4
ZAP_PORT=8090
TRIVY_SERVER_URL=http://trivy:4954
TRIVY_PORT=4954
WAZUH_API_URL=https://wazuh-manager:55000
WAZUH_API_USER=wazuh-wui
WAZUH_API_PASSWORD=MyS3cr37P450r.*-
WAZUH_INDEXER_PASSWORD=SecretPassword
WAZUH_VERIFY_TLS=false
WAZUH_API_PORT=55000

WAZUH_INDEXER_JAVA_OPTS=-Xms2g -Xmx2g -XX:MaxDirectMemorySize=512m
# Dynamic host-capacity performance + shared live plan (Redis) for all workers
DYNAMIC_PERF_ENABLED=true
DYNAMIC_PERF_FORCE=false
# adaptive = cool uses .env ceilings; heat only decreases. respect_env = never exceed env.
PERF_POLICY_MODE=throughput
# Optional: fast LLM confirms plan when GPU idle (never loads during OCR/RAG). Default off.
PERF_LLM_ADVISOR=false
# Honor user thermal ceilings; still hard-cap abort under OEM trip (~95-100C).
GPU_THERMAL_HONOR_ENV=true
# Lock hard safety ceilings / devices; batches adapt via Redis live plan under heat.
DYNAMIC_PERF_LOCK=PARSE_WORKERS,PARSE_PARALLEL_BUCKETS,PARSE_PARALLEL_ENABLED,PARSE_DRAIN_BATCH_LIMIT,PARSE_DRAIN_MAX_ROUNDS,PARSE_DRAIN_INTERLEAVE_RAG,FORENSIC_WORKER_CONCURRENCY,MAX_CONCURRENT_DISK_BUILDS,RAG_BATCH_SIZE,RAG_BATCH_SIZE_CAP,RAG_CUDA_MEMORY_FRACTION,OCR_BATCH_LIMIT,OCR_CPU_WORKERS,OCR_DEVICE,OCR_CUDA_MEMORY_FRACTION,OCR_CELERY_CONCURRENCY,OCR_PARALLEL_BUCKETS,OCR_DOCUMENTS_ONLY,AXIOM_INVENTORY_WORKERS,AXIOM_INVENTORY_BATCH_SIZE,EXTRACT_MOBILE_WORKERS,EXTRACT_DISK_WORKERS,EXTRACT_SHARD_COUNT,EXTRACT_UPLOAD_CONCURRENCY,GPU_HEAVY_MAX_CONCURRENT,PHASE3_STREAM_OCR_DURING_EXTRACT,PHASE3_STREAM_DURING_EXTRACT,PIPELINE_SEQUENTIAL_AGENTS,DEFER_BACKGROUND_RAG_WHILE_OCR,PIPELINE_STALE_SEC,PIPELINE_SUPERVISOR_INTERVAL_SEC,GPU_THERMAL_ABORT_C,GPU_THERMAL_PAUSE_C,GPU_THERMAL_THROTTLE_C,GPU_THERMAL_START_MAX_C,GPU_THERMAL_RESUME_C,CPU_THERMAL_THROTTLE_C,CPU_THERMAL_PAUSE_C
# Artifact inventory workers (live plan + CPU thermal scale these down when hot)
AXIOM_INVENTORY_WORKERS=8
AXIOM_INVENTORY_BATCH_SIZE=200

#APP_BASE_URL=https://122.170.114.36
RAG_DEFAULT_PROCESSING_PROFILE=STANDARD
GVM_REPORT_MIN_QOD=0
GVM_MIN_NVT_COUNT=10000
GVM_ALLOW_BARE_TASK_FALLBACK=false
GVM_SAFE_CHECKS=true
GVM_CHECKS_READ_TIMEOUT=10
GVM_TIMEOUT_RETRY=3
GVM_OPEN_SOCK_MAX_ATTEMPTS=5
GVM_EXPAND_VHOSTS=true
GVM_TEST_EMPTY_VHOST=true
VULN_SEVERITY_PROFILE=aetheris
FORENSIC_WORKER_CONCURRENCY=8
PIPELINE_SEQUENTIAL_AGENTS=false
CELERY_LIGHT_CONCURRENCY=2
OCR_CELERY_CONCURRENCY=1
OCR_PARALLEL_BUCKETS=0
OMP_NUM_THREADS=2
MKL_NUM_THREADS=2
TOKENIZERS_PARALLELISM=false
RAG_DB_FETCH_BATCH=500

# --- V21/V22 (2026-09-22): mobile export layout + non-blocking List folder ---
# List folder: parallel scanners for deep walks and a wall-clock cap (seconds, 0 = no cap).
# Case-layout runs (05_Exports/<run> with the four packages) never deep-walk and ignore the cap.
LIST_FOLDER_WORKERS=16
LIST_FOLDER_MAX_ENTRIES=500000
LIST_FOLDER_MAX_SECONDS=900
# Mobile export layout: 05_Exports/<run> holds exactly <run>.zip/.ufd/.pas/.ufdx.
# Set to 1 only if you need multi-part .part-NNNNN.zip output (resumable, legacy).
AETHERIS_EXPORT_SHARDS=0
# Free-space reserve kept while the full ZIP is written (V20; min 0.25).
AETHERIS_EXPORT_RESERVE_GB=1

REDIS_HOST_PORT=6380

RESOURCE_GOVERNOR_CPU_MAX_SLOTS=10
RESOURCE_GOVERNOR_GPU_MAX_SLOTS=1

# Movable folder for disk/mobile processing data (outside DockerDesktopWSL).
AETHERIS_BACKUP_DIR=F:/PolaronBackup


# V45 worker DB pool (see docker-compose.yml x-worker-env)
WORKER_DB_POOL_SIZE=4
WORKER_DB_MAX_OVERFLOW=8
DB_POOL_TIMEOUT=90
# V45 scratch on fast storage (host path mounted at /scratch in worker-disk)
EXTRACT_SCRATCH_HOST_DIR=F:/PolaronBackup/forensic-data/scratch

# V45.3 container lifecycle + evidence staging
CELERY_REMAP_SIGTERM=SIGQUIT
CELERY_SHUTDOWN_RELEASE_GPU=true
# Virtual drive letter for the evidence_staging volume (must NOT exist on the Windows host)
EVIDENCE_STAGING_LETTER=z
