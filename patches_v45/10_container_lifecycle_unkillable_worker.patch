+# V45.3 container lifecycle. Celery runs as PID 1 (entrypoint execvp); without an init
+# process signals are not forwarded/reaped, and compose's default 10 s grace then
+# SIGKILLs the worker mid-task. A child blocked in uninterruptible I/O (9p/gRPC-FUSE
+# bind mount of G:\ evidence) or inside a CUDA call cannot be killed, the PID
+# namespace never tears down and Docker reports
+#   "cannot stop container: tried to kill container, but did not receive an exit event".
+# tini + a real grace period + Celery cold shutdown (REMAP_SIGTERM) make stops
+# deterministic; acks_late tasks are redelivered after restart.
+x-worker-lifecycle: &worker-lifecycle
+  init: true
+  stop_signal: SIGTERM
+  stop_grace_period: 120s
+
 # Probe host room (CPU/RAM/GPU/thermal) then exec celery — see scripts/dynamic_perf_entrypoint.py
 x-dynamic-entrypoint: &dynamic-entrypoint
